{
  "name": "milkdown-vendor",
  "version": "1.0.0",
  "description": "Pre-bundled Milkdown ESM files for no-build projects",
  "type": "module",
  "scripts": {
    "build:js": "rollup -c",
    "build:css": "node copy-css.js",
    "postbuild:css": "node post-build-css-replace.js",
    "build": "npm run build:js && npm run build:css && npm run postbuild:css"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.22.0",
    "@milkdown/kit": "^7.5.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^6.0.3",
    "rollup": "^4.20.0"
  }
}
